# Auto-detect text files and normalize line endings
* text=auto

# Force UTF-8 for specific files
*.txt text eol=lf working-tree-encoding=UTF-8
*.py text eol=lf working-tree-encoding=UTF-8
*.json text eol=lf working-tree-encoding=UTF-8
requirements.txt text eol=lf working-tree-encoding=UTF-8

# Treat binary files as binary (don't modify)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.tar binary
*.gz binary
